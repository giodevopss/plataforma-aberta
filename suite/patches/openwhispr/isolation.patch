diff --git a/src/helpers/managed-process-registry.cjs b/src/helpers/managed-process-registry.cjs
new file mode 100644
index 0000000..2dd64c1
--- /dev/null
+++ b/src/helpers/managed-process-registry.cjs
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: MIT
+// Track only children started by this managed app; no system process scan.
+const fs = require("node:fs");
+const path = require("node:path");
+const crypto = require("node:crypto");
+const childProcess = require("node:child_process");
+const { identity } = require("./managed-process-identity.cjs");
+let installed = false;
+let directory = null;
+let directoryGetter = null;
+const originals = new Map();
+const children = new Map();
+function record(child) {
+  if (!child || typeof child.once !== "function") return child;
+  const entry = { child, file: null, exited: false };
+  children.set(child, entry);
+  const publish = () => {
+    if (
+      !directory ||
+      entry.exited ||
+      entry.file ||
+      !Number.isInteger(child.pid)
+    )
+      return;
+    const name =
+      "child-" +
+      child.pid +
+      "-" +
+      crypto.randomBytes(8).toString("hex") +
+      ".pid";
+    entry.file = path.join(directory, "sidecar-pids", name);
+    fs.writeFileSync(
+      entry.file,
+      JSON.stringify({ version: 1, pid: child.pid, identity: null }) + "\n",
+      { mode: 0o600, flag: "wx" },
+    );
+    identity(child.pid)
+      .then((started) => {
+        if (entry.exited || !started) return;
+        const temporary = entry.file + ".tmp";
+        fs.writeFileSync(
+          temporary,
+          JSON.stringify({ version: 1, pid: child.pid, identity: started }) +
+            "\n",
+          { mode: 0o600, flag: "wx" },
+        );
+        fs.renameSync(temporary, entry.file);
+      })
+      .catch((error) => {
+        if (entry.exited) return;
+        fs.rmSync(path.join(directory, "plataforma-process-registry.json"), {
+          force: true,
+        });
+        console.error(
+          "Managed native process identity could not be recorded:",
+          error.message,
+        );
+      });
+  };
+  const remove = () => {
+    entry.exited = true;
+    children.delete(child);
+    if (entry.file && fs.existsSync(entry.file)) fs.unlinkSync(entry.file);
+  };
+  entry.publish = publish;
+  child.once("spawn", publish);
+  child.once("exit", remove);
+  child.once("close", remove);
+  publish();
+  return child;
+}
+function install(options = {}) {
+  if (installed) return;
+  directoryGetter =
+    options.directory || (() => require("electron").app.getPath("userData"));
+  for (const name of ["spawn", "execFile", "exec", "fork"]) {
+    const original = childProcess[name];
+    originals.set(name, original);
+    childProcess[name] = function (...args) {
+      const child = original.apply(this, args);
+      return children.has(child) ? child : record(child);
+    };
+  }
+  require("node:module").syncBuiltinESMExports();
+  installed = true;
+}
+function ready() {
+  if (!installed) return false;
+  const root = directoryGetter();
+  if (!path.isAbsolute(root) || /[\0\r\n]/.test(root))
+    throw Error("Invalid managed process profile");
+  fs.mkdirSync(root, { recursive: true, mode: 0o700 });
+  if (fs.lstatSync(root).isSymbolicLink())
+    throw Error("Managed process profile cannot be a link");
+  directory = fs.realpathSync(root);
+  const pids = path.join(directory, "sidecar-pids");
+  fs.mkdirSync(pids, { recursive: true, mode: 0o700 });
+  if (fs.lstatSync(pids).isSymbolicLink())
+    throw Error("Managed sidecar registry cannot be a link");
+  const marker = path.join(directory, "plataforma-process-registry.json");
+  if (fs.existsSync(marker) && fs.lstatSync(marker).isSymbolicLink())
+    throw Error("Invalid native process capability marker");
+  fs.writeFileSync(marker, JSON.stringify({ version: 1 }) + "\n", {
+    mode: 0o600,
+  });
+  for (const entry of children.values()) entry.publish();
+  return true;
+}
+function resetForTests() {
+  for (const [name, original] of originals) childProcess[name] = original;
+  originals.clear();
+  require("node:module").syncBuiltinESMExports();
+  installed = false;
+  directory = null;
+  directoryGetter = null;
+}
+function shutdown() {
+  for (const { child } of children.values()) {
+    if (
+      child.exitCode === null &&
+      !child.killed &&
+      typeof child.kill === "function"
+    )
+      child.kill("SIGTERM");
+  }
+}
+module.exports = { install, ready, shutdown, resetForTests };
diff --git a/src/helpers/managed-process-identity.cjs b/src/helpers/managed-process-identity.cjs
new file mode 100644
index 0000000..b7dd1a5
--- /dev/null
+++ b/src/helpers/managed-process-identity.cjs
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+// Query only a recorded child PID. Never enumerate processes or command lines.
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { execFile } = require("node:child_process");
+let boot;
+const execute = (binary, args) =>
+  new Promise((resolve, reject) =>
+    execFile(
+      binary,
+      args,
+      {
+        windowsHide: true,
+        timeout: 15000,
+        maxBuffer: 100000,
+        env: { ...process.env, LANG: "C", LC_ALL: "C" },
+      },
+      (error, stdout) =>
+        error ? reject(error) : resolve(stdout.replace(/^\uFEFF/, "").trim()),
+    ),
+  );
+function exists(pid) {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    if (error.code === "ESRCH") return false;
+    throw error;
+  }
+}
+function powershell(script) {
+  const root = process.env.SystemRoot;
+  if (!root || !path.win32.isAbsolute(root))
+    throw Error("Windows system directory unavailable");
+  return execute(
+    path.join(root, "System32/WindowsPowerShell/v1.0/powershell.exe"),
+    [
+      "-NoProfile",
+      "-NonInteractive",
+      "-Command",
+      "[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new();" + script,
+    ],
+  );
+}
+async function bootIdentity() {
+  if (!boot)
+    boot = (async () => {
+      if (process.platform === "linux")
+        return (
+          await fs.readFile("/proc/sys/kernel/random/boot_id", "utf8")
+        ).trim();
+      if (process.platform === "darwin")
+        return execute("/usr/sbin/sysctl", ["-n", "kern.bootsessionuuid"]);
+      if (process.platform === "win32")
+        return powershell(
+          "(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().Ticks",
+        );
+      throw Error("Unsupported native process platform");
+    })().catch((error) => {
+      boot = null;
+      throw error;
+    });
+  return boot;
+}
+async function identity(pid) {
+  if (!Number.isInteger(pid) || pid < 1)
+    throw Error("Invalid recorded process PID");
+  const currentBoot = await bootIdentity();
+  try {
+    let started;
+    if (process.platform === "linux") {
+      const stat = await fs.readFile("/proc/" + pid + "/stat", "utf8");
+      started = stat.slice(stat.lastIndexOf(")") + 2).split(" ")[19];
+    } else if (process.platform === "darwin")
+      started = await execute("/bin/ps", ["-p", String(pid), "-o", "lstart="]);
+    else
+      started = await powershell(
+        "[System.Diagnostics.Process]::GetProcessById(" +
+          pid +
+          ").StartTime.ToUniversalTime().Ticks",
+      );
+    if (!started) {
+      if (!exists(pid)) return null;
+      throw Error("Native process start identity unavailable");
+    }
+    return JSON.stringify([currentBoot, started]);
+  } catch (error) {
+    if (!exists(pid)) return null;
+    throw error;
+  }
+}
+async function sameProcess(pid, expected) {
+  if (typeof expected !== "string")
+    throw Error("Native process identity is missing");
+  const token = JSON.parse(expected);
+  if (
+    !Array.isArray(token) ||
+    token.length !== 2 ||
+    token.some((item) => typeof item !== "string" || !item)
+  )
+    throw Error("Invalid native process identity");
+  if (token[0] !== (await bootIdentity())) return false;
+  return (await identity(pid)) === expected;
+}
+module.exports = { identity, sameProcess };
