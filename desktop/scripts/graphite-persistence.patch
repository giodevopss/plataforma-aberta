+// SPDX-License-Identifier: MIT OR Apache-2.0
+// JSON object order changes when a document's randomized HashMaps are
+// reconstructed in another process. Object order is not a persisted edit.
+pub fn snapshot_matches(stored: &[u8], current: &[u8]) -> Result<bool, serde_json::Error> {
+    let stored: serde_json::Value = serde_json::from_slice(stored)?;
+    let current: serde_json::Value = serde_json::from_slice(current)?;
+    Ok(stored == current)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::snapshot_matches;
+
+    #[test]
+    fn reloaded_object_order_preserves_the_document() {
+        assert!(snapshot_matches(br#"{"nodes":{"a":1,"b":2},"name":"QA"}"#, br#"{"name":"QA","nodes":{"b":2,"a":1}}"#).unwrap());
+    }
+
+    #[test]
+    fn changed_geometry_is_not_persisted() {
+        assert!(!snapshot_matches(br#"{"rectangle":{"width":220,"height":150}}"#, br#"{"rectangle":{"width":221,"height":150}}"#).unwrap());
+    }
+
+    #[test]
+    fn layer_order_is_meaningful() {
+        assert!(!snapshot_matches(br#"{"layers":[1,2]}"#, br#"{"layers":[2,1]}"#).unwrap());
+    }
+
+    #[test]
+    fn corrupt_storage_is_an_error() {
+        assert!(snapshot_matches(b"broken", br#"{"layers":[1,2]}"#).is_err());
+    }
+}
