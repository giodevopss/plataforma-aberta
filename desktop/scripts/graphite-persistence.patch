+	/// Await the original OPFS mutation queue and verify each open document before a suite backup or close.
+	#[cfg(all(not(feature = "native"), target_family = "wasm"))]
+	pub async fn flush_persistence(&self) -> Result<(), JsValue> {
+		for _ in 0..300 {
+			self.auto_save_all_documents();
+			let checkpoint = EDITOR.with(|slot| slot.lock().ok().and_then(|guard| guard.as_ref().and_then(Editor::persistence_checkpoint)));
+			if let Some(checkpoint) = checkpoint {
+				return checkpoint.await.map_err(|error| JsValue::from_str(&error));
+			}
+			// New document containers attach asynchronously through the original message loop.
+			let delay = js_sys::Promise::new(&mut |resolve, reject| {
+				if let Err(error) = web_sys::window().unwrap().set_timeout_with_callback_and_timeout_and_arguments_0(&resolve, 100) {
+					let _ = reject.call1(&JsValue::UNDEFINED, &error);
+				}
+			});
+			wasm_bindgen_futures::JsFuture::from(delay).await?;
+		}
+		Err(JsValue::from_str("Document storage did not become ready. Keep the editor open and export your work."))
+	}
