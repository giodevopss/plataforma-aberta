+	/// Capture owned document containers without retaining the editor lock across awaited I/O.
+	/// OPFS reads place a FIFO barrier after queued document/resource writes, then verify actual disk bytes.
+	#[cfg(target_family = "wasm")]
+	pub fn persistence_checkpoint(&self) -> Option<std::pin::Pin<Box<dyn std::future::Future<Output = Result<(), String>>>>> {
+		use document_container::{AnyContainer, AsyncContainer};
+		let mut checks = Vec::new();
+		for document in self.dispatcher.message_handlers.portfolio_message_handler.documents.values() {
+			let container = document.container.clone()?;
+			if !matches!(container, AnyContainer::Opfs(_)) {
+				return Some(Box::pin(async { Err("Persistent document storage is unavailable; keep the editor open and export your work.".to_string()) }));
+			}
+			checks.push((container, document.serialize_document()));
+		}
+		Some(Box::pin(async move {
+			for (container, expected) in checks {
+				let bytes = container.read(crate::messages::portfolio::document_storage_io::legacy_path()).await.map_err(|error| error.to_string())?;
+				if bytes.as_slice() != expected.as_bytes() && !persistence_checkpoint::snapshot_matches(bytes.as_slice(), expected.as_bytes()).map_err(|error| error.to_string())? {
+					return Err("The last edit has not reached persistent storage. Keep the editor open and try again.".to_string());
+				}
+			}
+			Ok(())
+		}))
 	}
 
